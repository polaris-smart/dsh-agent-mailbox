{
  "name": "dsh-agent-mailbox",
  "version": "0.8.0",
  "author": "polaris-smart",
  "description": "Project-scoped agent-mailbox tools for existing DeepSeek Harness sessions. Private session-file connection; no provider keys or managed CLI tasks.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polaris-smart/dsh-agent-mailbox.git"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "mailbox",
    "multi-agent",
    "agent-communication",
    "mcp"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist/",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "bash smoke.sh",
    "pack": "npm pack",
    "build": "tsc --noCheck -p tsconfig.build.json && node scripts/fix-dts-ext.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "license": "MIT"
}
