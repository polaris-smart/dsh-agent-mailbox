{
  "name": "dsh-agent-mailbox",
  "version": "0.1.2",
  "description": "dsh (DeepSeek Harness) 跨 agent 信箱插件：让 dsh 会话内的 agent 通过 agent-mailbox 与本机其他 agent（Claude Code / OpenCode / Hermes…）互发消息、收任务卡、卡动即唤醒。零 npm 依赖，Node 22 即装即用。",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polaris-smart/dsh-agent-mailbox.git"
  },
  "type": "module",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "mailbox",
    "multi-agent",
    "agent-communication",
    "mcp"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "files": [
    "dist/",
    "src/",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "typecheck": "tsc --noEmit",
    "smoke": "bash smoke.sh",
    "pack": "npm pack",
    "build": "tsc --noCheck -p tsconfig.build.json && node scripts/fix-dts-ext.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "main": "dist/plugin.js",
  "types": "dist/plugin.d.ts",
  "license": "MIT"
}